# Generate a secret, e.g. uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///./gopherfit.db
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Recovery requires opt-in verified email enrollment and a working TLS SMTP service.
RECOVERY_ENABLED=false
RECOVERY_TTL_SECONDS=1800
RECOVERY_FRONTEND_URL=https://your-frontend.example/recover
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=accounts@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10

AUTH_RATE_LIMIT=20
RECOVERY_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60
# JSON array of explicit origins (no trailing slash); no cookies are used by the API.
CORS_ORIGINS=[]
# Omit METRICS_TOKEN to disable /metrics; if set it must be at least 32 characters.
# METRICS_TOKEN=another-independent-long-random-secret
BACKUP_DIRECTORY=./backups
BACKUP_RETENTION=7
